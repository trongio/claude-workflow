#!/usr/bin/env bash
# wf: single entry point for the workflow plugin. On the Bash tool's PATH when
# the plugin is enabled; elsewhere run it by path or symlink it into ~/.local/bin.
#
#   card commands     list next claim move new prio show stats queue root   (bun scripts/wf.ts)
#   wf board          live board on http://127.0.0.1:8090
#   wf gates [...]    quality gates (gates.sh --help)
#   wf merge BRANCH   merge a branch into the base branch under a lock
#   wf cards-commit "msg"   commit tasks/ in the main checkout under the same lock
#   wf wt-init [DIR]  make a worktree runnable
#   wf review-diff    compact diff for reviewers
#   wf doc FILE [RE]  markdown heading tree / sections
#   wf outline FILE   symbol outline of source files
#   wf init [--write]   detect the stack, suggest or write .claude/workflow.json + tasks/
#   wf night [N]      queue N cards and run the overnight runner;  wf run: runner only
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
    dir="$(cd "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" == /* ]] || src="$dir/$src"
done
scripts="$(cd "$(dirname "$src")/../scripts" && pwd)"

runtime() {
    if command -v bun >/dev/null; then
        exec bun "$scripts/wf.ts" "$@"
    fi
    echo "wf: bun is required for card commands (https://bun.sh)" >&2
    exit 2
}

cmd="${1:-list}"
[ $# -gt 0 ] && shift
case "$cmd" in
gates) exec "$scripts/gates.sh" "$@" ;;
merge) exec "$scripts/wt-merge.sh" "$@" ;;
wt-init) exec "$scripts/wt-init.sh" "$@" ;;
review-diff) exec "$scripts/review-diff.sh" "$@" ;;
doc) exec "$scripts/doc.sh" "$@" ;;
outline) exec "$scripts/outline.sh" "$@" ;;
run) exec "$scripts/overnight-runner.sh" "$@" ;;
init)
    command -v bun >/dev/null || {
        echo "wf: bun is required (https://bun.sh)" >&2
        exit 2
    }
    exec bun "$scripts/init.ts" "$@"
    ;;
night)
    "$0" queue "${1:-8}"
    exec "$scripts/overnight-runner.sh"
    ;;
cards-commit)
    # shellcheck source=../scripts/lib/common.sh
    . "$scripts/lib/common.sh"
    main="$(wf_main)"
    wf_lock merge
    trap 'wf_unlock merge' EXIT
    git -C "$main" add -A tasks
    if git -C "$main" diff --cached --quiet -- tasks; then
        echo "no card changes to commit"
    else
        git -C "$main" commit -q -m "${1:-chore(tasks): update cards}" -- tasks && echo "committed cards: ${1:-chore(tasks): update cards}"
    fi
    ;;
-h | --help | help) sed -n '2,17p' "$src" | sed 's/^# \{0,1\}//' ;;
*) runtime "$cmd" "$@" ;;
esac
