#!/usr/bin/env bash
# wf: single entry point for the workflow plugin. On the Bash tool's PATH when
# the plugin is enabled; elsewhere run it by path or symlink it into ~/.local/bin.
#
#   card commands     list next claim move new prio show stats queue root   (bun scripts/wf.ts)
#   wf board          live board on http://127.0.0.1:8095
#   wf gates [...]    quality gates (wf gates --help)
#   wf merge BRANCH   merge a branch into the base branch under a lock
#   wf wt-init [DIR]  make a worktree runnable
#   wf review-diff    compact diff for reviewers
#   wf doc FILE [RE]  markdown heading tree / sections
#   wf outline FILE   symbol outline of source files
#   wf init [--write]   detect the stack, suggest or write .claude/workflow.json + tasks/
#   wf night [N]      queue N cards and run the overnight runner;  wf run: runner only
#   wf CMD --help     help for one command (never runs it)
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
    dir="$(cd "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" == /* ]] || src="$dir/$src"
done
scripts="$(cd "$(dirname "$src")/../scripts" && pwd)"

runtime() {
    if command -v bun >/dev/null; then
        exec bun "$scripts/wf.ts" "$@"
    fi
    echo "wf: bun is required for card commands (https://bun.sh)" >&2
    exit 2
}

cmd="${1:-list}"
[ $# -gt 0 ] && shift

# -h/--help anywhere in the arguments prints help and never runs the command.
for a in "$@"; do
    case "$a" in -h | --help) ;; *) continue ;; esac
    script=""
    case "$cmd" in
    gates) script=gates.sh ;;
    merge) script=wt-merge.sh ;;
    wt-init) script=wt-init.sh ;;
    review-diff) script=review-diff.sh ;;
    doc) script=doc.sh ;;
    outline) script=outline.sh ;;
    run | night) script=overnight-runner.sh ;;
    init) script=init.ts ;;
    board) runtime help board ;;
    cards-commit) script=cmd/cards-commit.sh ;;
    help | -h | --help) break ;;
    esac
    if [ -n "$script" ]; then
        # shellcheck source=../scripts/lib/common.sh
        . "$scripts/lib/common.sh"
        wf_help "$scripts/$script"
        exit 0
    fi
    if [ -x "$scripts/cmd/$cmd.sh" ]; then exec "$scripts/cmd/$cmd.sh" --help; fi
    if [ -f "$scripts/cmd/$cmd.ts" ]; then
        command -v bun >/dev/null || {
            echo "wf: bun is required (https://bun.sh)" >&2
            exit 2
        }
        exec bun "$scripts/cmd/$cmd.ts" --help
    fi
    runtime help "$cmd"
done

case "$cmd" in
gates) exec "$scripts/gates.sh" "$@" ;;
merge) exec "$scripts/wt-merge.sh" "$@" ;;
wt-init) exec "$scripts/wt-init.sh" "$@" ;;
review-diff) exec "$scripts/review-diff.sh" "$@" ;;
doc) exec "$scripts/doc.sh" "$@" ;;
outline) exec "$scripts/outline.sh" "$@" ;;
run) exec "$scripts/overnight-runner.sh" "$@" ;;
init)
    command -v bun >/dev/null || {
        echo "wf: bun is required (https://bun.sh)" >&2
        exit 2
    }
    exec bun "$scripts/init.ts" "$@"
    ;;
night)
    "$0" queue ${1:+"$1"}
    exec "$scripts/overnight-runner.sh"
    ;;
-h | --help | help)
    sed -n '2,15p' "$src" | sed 's/^# \{0,1\}//'
    for f in "$scripts"/cmd/*; do
        [ -e "$f" ] || continue
        printf '  wf %-14s %s\n' "$(basename "${f%.*}")" "$(sed -nE 's@^(#|//) wf-help: @@p' "$f" | head -1)"
    done
    ;;
*)
    # Drop-in subcommands: scripts/cmd/<name>.sh or .ts. Each starts with a
    # "# wf-help: ..." (or "// wf-help: ...") line that `wf help` lists.
    if [ -x "$scripts/cmd/$cmd.sh" ]; then exec "$scripts/cmd/$cmd.sh" "$@"; fi
    if [ -f "$scripts/cmd/$cmd.ts" ]; then
        command -v bun >/dev/null || {
            echo "wf: bun is required (https://bun.sh)" >&2
            exit 2
        }
        exec bun "$scripts/cmd/$cmd.ts" "$@"
    fi
    runtime "$cmd" "$@"
    ;;
esac
