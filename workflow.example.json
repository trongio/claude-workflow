{
  "$schema": "https://raw.githubusercontent.com/trongio/claude-workflow/main/schema/workflow.schema.json",
  "idPrefix": "APP",
  "baseBranch": "main",
  "wipLimit": 2,
  "timezone": "Europe/Berlin",
  "push": true,
  "milestone": { "label": "v1 launch" },
  "board": { "title": "App board", "host": "127.0.0.1", "port": 8090 },
  "gates": [
    { "name": "test", "cmd": "bun run test", "when": ["src/", "tests/", "package.json", "bun.lock"] },
    { "name": "lint", "cmd": "bun run lint", "when": ["*.ts", "*.tsx", "eslint.config.*"], "fix": "bun run lint --fix" },
    { "name": "typecheck", "cmd": "bun run typecheck", "when": ["*.ts", "*.tsx", "tsconfig*.json"] },
    { "name": "build", "cmd": "bun run build", "when": ["src/", "vite.config.*", "package.json"], "cache": true },
    { "name": "e2e", "cmd": "bun run e2e", "when": ["src/"], "cache": false }
  ],
  "gatesCache": true,
  "gatesTailLines": 30,
  "worktree": {
    "link": ["node_modules"],
    "copy": [".env"],
    "setup": []
  },
  "ui": true,
  "dev": {
    "url": "http://127.0.0.1:5173",
    "login": "Seeded user demo@example.test, credentials in .env.example (SEED_USER, SEED_SECRET); or register a throwaway account.",
    "viewports": [1440, 390],
    "check": "",
    "screenshots": ".workflow/shots"
  },
  "docs": { "design": ["docs/design.md"], "spec": ["docs/spec.md"] },
  "risk": { "high": ["migrations/", "src/auth/", "src/billing/", "deploy/"] },
  "overnight": {
    "parallel": 2,
    "maxHours": 24,
    "timeoutMinutes": 120,
    "retries": 2,
    "model": "opus",
    "permissionFlags": "--dangerously-skip-permissions"
  }
}
