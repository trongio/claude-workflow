{
  "id": "sveltekit-ts",
  "title": "SvelteKit + TypeScript + Drizzle + Postgres",
  "summary": "Small, fast full-stack TypeScript: form actions with progressive enhancement, load functions, Drizzle on Postgres.",
  "fits": [
    "phone-first web apps where bundle size and speed feel matter",
    "forms-heavy apps that should work before JS loads",
    "small teams reading TypeScript"
  ],
  "avoid": [
    "you need a large component ecosystem (React has more)",
    "batteries-included admin, queues and i18n from one framework"
  ],
  "languages": [
    "typescript"
  ],
  "ui": true,
  "uiDefault": "plain-css",
  "uiOptions": [
    "plain-css",
    "shadcn-tailwind"
  ],
  "packages": [
    "eol:nodejs",
    "npm:@sveltejs/kit",
    "npm:svelte",
    "npm:svelte-check",
    "npm:vite",
    "npm:typescript",
    "npm:drizzle-orm",
    "npm:drizzle-kit",
    "npm:better-auth",
    "npm:zod",
    "npm:@inlang/paraglide-js",
    "npm:vitest",
    "npm:@playwright/test",
    "npm:eslint",
    "npm:typescript-eslint",
    "npm:prettier",
    "npm:knip",
    "npm:jscpd",
    "eol:postgresql"
  ],
  "commands": {
    "install": "npm ci",
    "dev": "npm run dev",
    "test": "npx vitest run",
    "fmt": "npx prettier --write ."
  },
  "dev": {
    "url": "http://127.0.0.1:5173"
  },
  "layout": [
    "src/routes/         pages, +page.server.ts load/actions (authorize first line)",
    "src/lib/server/     use cases and the only DB callers (drizzle)",
    "src/lib/components/ catalogued components + /dev/gallery route",
    "messages/           paraglide catalogs per locale",
    "tests/e2e/          Playwright journeys"
  ],
  "gates": [
    {
      "name": "vitest",
      "cmd": "npx vitest run --changed \"$WF_BASE\" --passWithNoTests",
      "when": [
        "src/*.ts",
        "src/*.tsx",
        "src/*.svelte",
        "messages/",
        "package.json",
        "package-lock.json"
      ],
      "heavy": true,
      "release": false,
      "requires": [
        "node_modules/.bin/vitest"
      ]
    },
    {
      "name": "vitest-full",
      "cmd": "npx vitest run",
      "when": [
        "src/*.ts",
        "src/*.tsx",
        "src/*.svelte",
        "messages/",
        "package.json",
        "package-lock.json"
      ],
      "heavy": true,
      "inner": false,
      "requires": [
        "node_modules/.bin/vitest"
      ]
    },
    {
      "name": "typecheck",
      "cmd": "npx svelte-check --fail-on-warnings",
      "when": [
        "src/*.ts",
        "src/*.tsx",
        "src/*.svelte",
        "messages/",
        "package.json",
        "package-lock.json",
        "tsconfig*.json"
      ],
      "heavy": true,
      "requires": [
        "node_modules/.bin/svelte-check"
      ]
    },
    {
      "name": "eslint",
      "cmd": "npx eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/",
      "when": [
        "src/*.ts",
        "src/*.tsx",
        "src/*.svelte",
        "messages/",
        "package.json",
        "package-lock.json",
        "eslint.config.*"
      ],
      "fix": "npx eslint . --fix",
      "heavy": true,
      "requires": [
        "node_modules/.bin/eslint"
      ]
    },
    {
      "name": "prettier",
      "cmd": "npx prettier --check --cache .",
      "when": [
        "src/*.ts",
        "src/*.tsx",
        "src/*.svelte",
        "messages/",
        "package.json",
        "package-lock.json",
        "*.css",
        "*.json",
        "*.md"
      ],
      "fix": "npx prettier --write --cache .",
      "requires": [
        "node_modules/.bin/prettier"
      ]
    },
    {
      "name": "knip",
      "cmd": "npx knip --no-progress",
      "when": [
        "src/*.ts",
        "src/*.tsx",
        "src/*.svelte",
        "messages/",
        "package.json",
        "package-lock.json"
      ],
      "heavy": true,
      "requires": [
        "node_modules/.bin/knip"
      ]
    },
    {
      "name": "dupes",
      "cmd": "npx jscpd --silent --exitCode 1 --threshold 0 --min-tokens 70 src",
      "when": [
        "src/*.ts",
        "src/*.tsx",
        "src/*.svelte",
        "messages/",
        "package.json",
        "package-lock.json"
      ],
      "inner": false,
      "requires": [
        "node_modules/.bin/jscpd"
      ]
    },
    {
      "name": "build",
      "cmd": "npm run build",
      "when": [
        "src/*.ts",
        "src/*.tsx",
        "src/*.svelte",
        "messages/",
        "package.json",
        "package-lock.json",
        "*.css",
        "vite.config.*"
      ],
      "heavy": true,
      "requires": [
        "node_modules/.bin/vite"
      ]
    },
    {
      "name": "e2e",
      "cmd": "npx playwright test",
      "when": [
        "src/*.ts",
        "src/*.tsx",
        "src/*.svelte",
        "messages/",
        "package.json",
        "package-lock.json",
        "tests/e2e/"
      ],
      "heavy": true,
      "inner": false,
      "cache": false,
      "requires": [
        "node_modules/.bin/playwright"
      ]
    },
    {
      "name": "migrations",
      "cmd": "npx drizzle-kit check",
      "when": [
        "src/lib/server/db/",
        "drizzle.config.*"
      ],
      "inner": false,
      "requires": [
        "node_modules/.bin/drizzle-kit"
      ]
    },
    {
      "name": "tokens",
      "cmd": "! rg -n --pcre2 --glob '!**/app.css' --glob '!**/tokens.css' '[\"\\x27`:(\\[]\\s*#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})\\b|\\[-?[0-9.]+(?:px|rem)\\]|style=\\{\\{|style=\\x22' src",
      "when": [
        "src/"
      ],
      "requires": [
        "rg"
      ]
    },
    {
      "name": "secrets",
      "cmd": "gitleaks git --no-banner --redact --exit-code 1",
      "when": [
        "*"
      ],
      "inner": false,
      "cache": false,
      "requires": [
        "gitleaks"
      ]
    },
    {
      "name": "shellcheck",
      "cmd": "git ls-files -z '*.sh' | xargs -0 -r shellcheck",
      "when": [
        "*.sh"
      ],
      "requires": [
        "shellcheck"
      ]
    }
  ],
  "worktree": {
    "link": [
      "node_modules"
    ],
    "copy": [
      ".env"
    ],
    "setup": [
      "npx svelte-kit sync"
    ],
    "cache": [
      "node_modules/.cache",
      "node_modules/.vite"
    ],
    "env": {
      "DATABASE_URL": "postgres://app:app@127.0.0.1:5432/app_{slug}",
      "PORT": "{port}"
    }
  },
  "risk": {
    "high": [
      "src/lib/server/db/",
      "drizzle/",
      "src/lib/server/auth/",
      "src/hooks.server.ts",
      "infra/",
      ".github/"
    ]
  },
  "standards": "sveltekit-ts.standards.md"
}
