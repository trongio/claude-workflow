{
  "id": "node-hono-api",
  "title": "Node + Hono API (TypeScript, zod, Drizzle, Postgres)",
  "summary": "A typed HTTP API in TypeScript: Hono routes with zod validation and an OpenAPI document generated from the same schemas, Drizzle on Postgres.",
  "fits": [
    "APIs and backends-for-frontends where the team reads TypeScript",
    "edge or serverless deploys (Hono runs on Node, Bun, Workers)",
    "a contract-first public API"
  ],
  "avoid": [
    "a rich web UI is the product (pair it with a UI stack)",
    "you need queues, admin and i18n from one framework"
  ],
  "languages": [
    "typescript"
  ],
  "ui": false,
  "uiDefault": "native",
  "uiOptions": [
    "native"
  ],
  "packages": [
    "eol:nodejs",
    "npm:hono",
    "npm:@hono/node-server",
    "npm:@hono/zod-openapi",
    "npm:zod",
    "npm:drizzle-orm",
    "npm:drizzle-kit",
    "npm:pino",
    "npm:typescript",
    "npm:vitest",
    "npm:eslint",
    "npm:typescript-eslint",
    "npm:prettier",
    "npm:knip",
    "npm:jscpd",
    "eol:postgresql"
  ],
  "commands": {
    "install": "npm ci",
    "dev": "npm run dev",
    "test": "npx vitest run",
    "fmt": "npx prettier --write ."
  },
  "dev": {
    "url": "http://127.0.0.1:3000"
  },
  "layout": [
    "src/index.ts        server wiring only",
    "src/routes/         one file per resource: zod schemas -> OpenAPI route -> service call",
    "src/services/       use cases: authorize, validate, transact, audit; the only DB callers",
    "src/db/             drizzle schema + migrations",
    "openapi.json        generated contract, committed; a test fails when it is stale"
  ],
  "gates": [
    {
      "name": "vitest",
      "cmd": "npx vitest run --changed \"$WF_BASE\" --passWithNoTests",
      "when": [
        "src/*.ts",
        "src/*.tsx",
        "test/",
        "package.json",
        "package-lock.json"
      ],
      "heavy": true,
      "release": false,
      "requires": [
        "node_modules/.bin/vitest"
      ]
    },
    {
      "name": "vitest-full",
      "cmd": "npx vitest run",
      "when": [
        "src/*.ts",
        "src/*.tsx",
        "test/",
        "package.json",
        "package-lock.json"
      ],
      "heavy": true,
      "inner": false,
      "requires": [
        "node_modules/.bin/vitest"
      ]
    },
    {
      "name": "typecheck",
      "cmd": "npx tsc --noEmit",
      "when": [
        "src/*.ts",
        "src/*.tsx",
        "test/",
        "package.json",
        "package-lock.json",
        "tsconfig*.json"
      ],
      "heavy": true,
      "requires": [
        "node_modules/.bin/tsc"
      ]
    },
    {
      "name": "eslint",
      "cmd": "npx eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/",
      "when": [
        "src/*.ts",
        "src/*.tsx",
        "test/",
        "package.json",
        "package-lock.json",
        "eslint.config.*"
      ],
      "fix": "npx eslint . --fix",
      "heavy": true,
      "requires": [
        "node_modules/.bin/eslint"
      ]
    },
    {
      "name": "prettier",
      "cmd": "npx prettier --check --cache .",
      "when": [
        "src/*.ts",
        "src/*.tsx",
        "test/",
        "package.json",
        "package-lock.json",
        "*.css",
        "*.json",
        "*.md"
      ],
      "fix": "npx prettier --write --cache .",
      "requires": [
        "node_modules/.bin/prettier"
      ]
    },
    {
      "name": "knip",
      "cmd": "npx knip --no-progress",
      "when": [
        "src/*.ts",
        "src/*.tsx",
        "test/",
        "package.json",
        "package-lock.json"
      ],
      "heavy": true,
      "requires": [
        "node_modules/.bin/knip"
      ]
    },
    {
      "name": "dupes",
      "cmd": "npx jscpd --silent --exitCode 1 --threshold 0 --min-tokens 70 src",
      "when": [
        "src/*.ts",
        "src/*.tsx",
        "test/",
        "package.json",
        "package-lock.json"
      ],
      "inner": false,
      "requires": [
        "node_modules/.bin/jscpd"
      ]
    },
    {
      "name": "build",
      "cmd": "npx tsc -p tsconfig.build.json",
      "when": [
        "src/",
        "tsconfig*.json",
        "package.json"
      ],
      "heavy": true,
      "inner": false,
      "requires": [
        "node_modules/.bin/tsc"
      ]
    },
    {
      "name": "migrations",
      "cmd": "npx drizzle-kit check",
      "when": [
        "src/db/",
        "drizzle.config.*"
      ],
      "inner": false,
      "requires": [
        "node_modules/.bin/drizzle-kit"
      ]
    },
    {
      "name": "secrets",
      "cmd": "gitleaks git --no-banner --redact --exit-code 1",
      "when": [
        "*"
      ],
      "inner": false,
      "cache": false,
      "requires": [
        "gitleaks"
      ]
    },
    {
      "name": "shellcheck",
      "cmd": "git ls-files -z '*.sh' | xargs -0 -r shellcheck",
      "when": [
        "*.sh"
      ],
      "requires": [
        "shellcheck"
      ]
    }
  ],
  "worktree": {
    "link": [
      "node_modules"
    ],
    "copy": [
      ".env"
    ],
    "setup": [],
    "cache": [
      "node_modules/.cache"
    ],
    "env": {
      "DATABASE_URL": "postgres://app:app@127.0.0.1:5432/app_{slug}",
      "PORT": "{port}"
    }
  },
  "risk": {
    "high": [
      "src/db/",
      "drizzle/",
      "src/middleware/auth*",
      "src/services/billing/",
      "infra/",
      ".github/"
    ]
  },
  "standards": "node-hono-api.standards.md"
}
